{
  "name": "@aspectly/web",
  "version": "2.2.0",
  "description": "Web/iframe integration for Aspectly bridge - React hooks for embedding and communicating with iframes",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "keywords": [
    "iframe",
    "bridge",
    "communication",
    "react",
    "hooks",
    "postmessage",
    "web"
  ],
  "author": "Zhan Isaakian <jeanisahkyan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeanIsahakyan/aspectly",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/JeanIsahakyan/aspectly/issues"
  },
  "homepage": "https://github.com/JeanIsahakyan/aspectly/tree/main/packages/web#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "dependencies": {
    "@aspectly/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "rimraf": "^5.0.5"
  }
}
